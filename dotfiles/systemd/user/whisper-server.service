[Unit]
Description=whisper.cpp server for push-to-talk dictation
Documentation=https://github.com/ggml-org/whisper.cpp

[Service]
Type=simple
# keeps the model resident so dictate never pays a reload; idles at ~0 CPU
ExecStart=%h/.local/bin/whisper-server \
    --model %h/.local/share/whisper-models/ggml-base.en-q5_1.bin \
    --host 127.0.0.1 \
    --port 8117 \
    --threads 4 \
    --no-timestamps
# whisper is bursty and the desktop matters more than a few hundred ms
CPUSchedulingPolicy=batch
Nice=5
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
