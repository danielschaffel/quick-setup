#!/bin/bash
# dictate - push-to-talk speech to text
#
# usage: dictate start | stop | toggle | cancel | status
#
# records 16k mono from the default pipewire source, transcribes with
# whisper.cpp and types the result into the focused window.
#
# talks to the resident whisper-server when it is up (no model reload,
# much snappier) and falls back to whisper-cli if it is not.

set -uo pipefail

MODEL="${WHISPER_MODEL:-$HOME/.local/share/whisper-models/ggml-base.en-q5_1.bin}"
SERVER_URL="${WHISPER_SERVER_URL:-http://127.0.0.1:8117}"
THREADS="${WHISPER_THREADS:-4}"

# hard cap on a single take. a recorder that never dies is what wedges this
# thing, and whisper's accuracy falls off a cliff past a couple of minutes.
MAX_SECONDS="${DICTATE_MAX_SECONDS:-60}"

# wtype defaults to 0ms between keystrokes, which floods the compositor on a
# long transcript. a 1ms gap is imperceptible and keeps the screen calm.
TYPE_DELAY="${DICTATE_TYPE_DELAY:-1}"

RUNTIME="${XDG_RUNTIME_DIR:-/tmp}/dictate"
WAV="$RUNTIME/rec.wav"
PIDFILE="$RUNTIME/rec.pid"
LOCKFILE="$RUNTIME/dictate.lock"

mkdir -p "$RUNTIME"

# one line per invocation, so a misbehaving bind can be diagnosed after the
# fact instead of guessed at
LOG="$RUNTIME/dictate.log"
printf '%s  %-6s pid=%-7s\n' "$(date +%H:%M:%S.%3N)" "${1:-toggle}" "$$" >>"$LOG"

# serialise every invocation. hyprland can fire a bind more than once and two
# concurrent starts used to spawn two recorders onto one file, which corrupted
# the audio and orphaned a process holding the mic.
exec 9>"$LOCKFILE"
flock -n 9 || exit 0

# keep whisper on the P-cores so a burst doesn't stall the desktop
PIN=()
if [ -r /sys/devices/cpu_core/cpus ]; then
    PIN=(taskset -c "$(cat /sys/devices/cpu_core/cpus)")
fi

notify() {
    command -v notify-send >/dev/null 2>&1 &&
        notify-send -a dictate -t "${2:-2000}" -h string:x-canonical-private-synchronous:dictate "$1" || true
}

is_recording() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null
}

start() {
    is_recording && exit 0

    # reap anything left over from a previous run before claiming the file
    pkill -f "pw-record .*$RUNTIME" 2>/dev/null
    rm -f "$WAV"

    # timeout forwards SIGINT, so both the cap and a normal stop let
    # pw-record finalise the wav header instead of truncating it.
    # 9>&- keeps the recorder from inheriting (and holding) the lock.
    timeout -s INT "$MAX_SECONDS" \
        pw-record --rate 16000 --channels 1 --format s16 "$WAV" >/dev/null 2>&1 9>&- &
    echo $! >"$PIDFILE"
    notify "🎤 Listening…" "$((MAX_SECONDS * 1000))"
}

stop() {
    is_recording || { rm -f "$PIDFILE"; exit 0; }

    pid=$(cat "$PIDFILE")
    rm -f "$PIDFILE"

    kill -INT "$pid" 2>/dev/null
    for _ in $(seq 1 100); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.02
    done
    pkill -f "pw-record .*$RUNTIME" 2>/dev/null

    [ -s "$WAV" ] || { notify "🎤 nothing recorded"; exit 0; }
    # under ~0.25s of 16k mono s16 is a stray keypress, not speech
    [ "$(stat -c %s "$WAV")" -gt 8000 ] || { notify "🎤 too short"; exit 0; }

    secs=$(( $(stat -c %s "$WAV") / 32000 ))
    notify "🎤 Transcribing ${secs}s…" 30000

    # no separate health probe: it cost a round trip and would itself stall
    # behind a busy server. a failed connect is the fallback signal.
    text=$(curl -sf --connect-timeout 1 --max-time 300 \
        -F file=@"$WAV" \
        -F response_format=text \
        -F temperature=0 \
        "$SERVER_URL/inference" 2>/dev/null)

    if [ -z "${text//[[:space:]]/}" ] && command -v whisper-cli >/dev/null 2>&1; then
        text=$("${PIN[@]}" whisper-cli -m "$MODEL" -f "$WAV" -t "$THREADS" -nt -np 2>/dev/null)
    fi

    # drop whisper's non-speech annotations and collapse whitespace
    text=$(printf '%s' "$text" |
        sed -E 's/\[[^]]*\]//g; s/\([^)]*\)//g' |
        tr '\n' ' ' |
        sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')

    if [ -z "$text" ]; then
        notify "🎤 no speech detected"
        exit 0
    fi

    # drop the lock before the output stage. wl-copy daemonises to serve the
    # selection, and it used to inherit fd 9 and hold the lock for as long as
    # it owned the clipboard - which silently wedged every later invocation.
    exec 9>&-

    # clipboard first so nothing is lost if the window rejects synthetic input
    command -v wl-copy >/dev/null 2>&1 && printf '%s' "$text" | wl-copy 9>&- 2>/dev/null

    if command -v wtype >/dev/null 2>&1; then
        wtype -d "$TYPE_DELAY" -- "$text" 9>&-
        notify "🎤 ${text:0:60}"
    else
        notify "🎤 copied (install wtype to type): ${text:0:60}" 4000
    fi
}

cancel() {
    is_recording || { rm -f "$PIDFILE"; notify "🎤 nothing to cancel"; exit 0; }
    pid=$(cat "$PIDFILE")
    rm -f "$PIDFILE"
    kill -INT "$pid" 2>/dev/null
    pkill -f "pw-record .*$RUNTIME" 2>/dev/null
    rm -f "$WAV"
    notify "🎤 discarded"
}

case "${1:-toggle}" in
start)  start ;;
stop)   stop ;;
cancel) cancel ;;
toggle) if is_recording; then stop; else start; fi ;;
status) if is_recording; then echo "recording"; else echo "idle"; fi ;;
*)      echo "usage: dictate {start|stop|toggle|cancel|status}" >&2; exit 1 ;;
esac
